    {
      "id": "de.maximum-ascii",
      "domain": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.de",
      "source_ids": [
        "denic-guidelines-de"
      ],
      "expected": {
        "passed_rule_ids": [
          "de.label-maximum"
        ]
      },
      "rationale": "V(2) permits a 63-character ASCII label; this is an exact boundary test."
    },
    {
      "id": "de.maximum-ace",
      "domain": "üüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüü.de",
      "source_ids": [
        "denic-guidelines-de"
      ],
      "expected": {
        "passed_rule_ids": [
          "de.label-maximum",
          "de.idn-repertoire"
        ]
      },
      "rationale": "This applicant label has 57 Unicode characters but a 63-character ACE label, exercising the measurement expressly required by V(2)."
    },
    {
      "id": "de.exceeds-ace",
      "domain": "üüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüü.de",
      "source_ids": [
        "denic-guidelines-de"
      ],
      "expected": {
        "name_validity": "invalid"
      },
      "rationale": "One additional Unicode character exceeds the 63-character ACE bound even though the applicant Unicode length is below 63."
    },
    {
      "id": "de.exceeds-dns-label",
      "domain": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.de",
      "source_ids": [
        "denic-guidelines-de"
      ],
      "expected": {
        "name_validity": "invalid"
      },
      "rationale": "The ACE maximum in V(2) also agrees with the independent DNS label bound."
